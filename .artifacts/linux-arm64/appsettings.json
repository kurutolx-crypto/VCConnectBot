{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Relay": {
    "EmptyChannelTimeout": "00:03:00",
    "SilenceTimeout": "00:10:00",
    "SilenceThreshold": 0.01
  },
  "Audio": {
    "SampleRate": 48000,
    "Channels": 2,
    "FrameDurationMilliseconds": 20,
    "MaxBufferedFrames": 25
  },
  "AllowedHosts": "*"
}
